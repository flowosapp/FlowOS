type View = 'dashboard' | 'command' | 'habits' | 'projects' | 'finance' | 'focus' | 'billing'
type OnboardingField =
  | 'goals'
  | 'routine'
  | 'friction'
  | 'habits'
  | 'targets'
  | 'productivity'
  | 'money'
  | 'priorities'

type Profile = Record<OnboardingField, string[]>

type HabitTone = 'blue' | 'green' | 'amber' | 'rose'
type TaskPriority = 'P0' | 'P1' | 'P2'
type FinanceKind = 'income' | 'expense' | 'subscription'
type PlanId = 'starter' | 'pro' | 'flowplus'
type SubscriptionStatus = 'trialing' | 'active' | 'past_due' | 'canceled'

type Habit = {
  id: string
  name: string
  area: string
  streak: number
  target: string
  week: number[]
  tone: HabitTone
}

type ProjectStatus = 'Backlog' | 'In progress' | 'Review' | 'Done'

type ProjectTask = {
  id: string
  title: string
  project: string
  status: ProjectStatus
  priority: TaskPriority
  estimate: string
}

type HabitDraft = {
  name: string
  area: string
  target: string
  tone: HabitTone
}

type TaskDraft = {
  title: string
  project: string
  priority: TaskPriority
  estimate: string
}

type FinanceEntry = {
  id: string
  title: string
  category: string
  amount: number
  kind: FinanceKind
}

type FinanceDraft = {
  title: string
  category: string
  amount: string
  kind: FinanceKind
}

type Subscription = {
  plan: PlanId
  status: SubscriptionStatus
  trialStartedAt: string
  trialEndsAt: string
  billingStartsAt: string
}

type DailyPlan = {
  intention: string
  outcome: string
  energy: 'Alta' | 'Estável' | 'Baixa'
  review: string
  completedSteps: string[]
}

type AppState = {
  onboardingComplete: boolean
  onboardingStep: number
  activeView: View
  profile: Profile
  habits: Habit[]
  completedHabits: string[]
  habitDraft: HabitDraft
  editingHabitId: string | null
  projectTasks: ProjectTask[]
  taskDraft: TaskDraft
  editingTaskId: string | null
  financeEntries: FinanceEntry[]
  financeDraft: FinanceDraft
  subscription: Subscription
  authEmail: string
  authUserId: string | null
  authUserEmail: string | null
  authMessage: string
  billingMessage: string
  billingLoadingPlan: PlanId | null
  stripeCustomerId: string | null
  dailyPlan: DailyPlan
  commandInput: string
  aiResponse: string
  focusDuration: number
  focusRemaining: number
  focusRunning: boolean
}

